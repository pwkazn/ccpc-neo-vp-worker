{
  "name": "ccpc-neo-vp",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": {
    "command": "npm run build",
    "watch_dir": ["web", "shared", "scripts"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
